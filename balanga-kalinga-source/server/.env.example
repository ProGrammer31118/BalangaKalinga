# Balanga Kalinga server configuration
# Copy this file to ".env" and fill in what you need.
# The server loads this file automatically on startup.

# ---- MySQL / XAMPP (defaults work for a default XAMPP install) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=balanga_kalinga

# ---- Real AI (Kalinga AI live mode) ----
# Add a real API key and the chat uses a live LLM instead of the offline demo engine.
OPENAI_API_KEY=
# Chat model (OpenRouter): deepseek/deepseek-chat is cheap and fast.
OPENAI_MODEL=deepseek/deepseek-chat
# OpenRouter (many models) uses an OpenAI-compatible endpoint:
#   https://openrouter.ai/api/v1
# Optional: use any other OpenAI-compatible provider instead.
#   Groq (free): https://console.groq.com            -> OPENAI_BASE_URL=https://api.groq.com/openai/v1 , OPENAI_MODEL=llama-3.3-70b-versatile
#   Google AI Studio (Gemini): https://aistudio.google.com/apikey -> OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai , OPENAI_MODEL=gemini-3.6-flash
#   Qwen/DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1 , OPENAI_MODEL=qwen3.5-flash
#   DeepSeek: https://api.deepseek.com , OPENAI_MODEL=deepseek-chat
#   Ollama (local/offline): http://localhost:11434/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: change the JWT secret used for login tokens.
JWT_SECRET=balanga-kalinga-demo-secret

# ---- Password reset email (Brevo) ----
# Create a free key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
# Sender — verify this address in Brevo (Senders & IP) so it can send
BREVO_SENDER_EMAIL=aestrada6060@gmail.com
BREVO_SENDER_NAME=Balanga Kalinga
# Public URL of the app so reset links work (e.g. https://balanga-kalinga-source.vercel.app)
APP_URL=https://balanga-kalinga-source.vercel.app